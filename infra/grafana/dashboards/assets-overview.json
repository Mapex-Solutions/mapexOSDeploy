            "fillOpacity": 15
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(assets_asset_cache_total[5m])",
          "legendFormat": "{{result}}"
        }
      ]
    },
