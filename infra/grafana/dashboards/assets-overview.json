  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Asset Operations",
      "type": "row"
    },
    {
      "title": "Total Asset Ops",
      "description": "Cumulative asset CRUD operations since the last restart. Includes all operations (create, get, update, delete, list) across all statuses (success, error). Use this to gauge overall asset activity volume.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 40,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(assets_asset_operations_total)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "title": "Asset Errors",
      "description": "Cumulative asset operations that ended in error since the last restart. Growth without corresponding load increase indicates a systemic issue (e.g., MongoDB down, validation failures).",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 41,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(assets_asset_operations_total{status=\"error\"})",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "title": "Asset Operations Rate",
      "description": "Asset CRUD operations per second broken down by operation (create, get, update, delete, list) and status (success, error). A healthy system shows mostly success. Sustained error rate indicates DB or validation issues.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(assets_asset_operations_total[5m])",
          "legendFormat": "{{operation}} / {{status}}"
        }
      ]
    },
    {
      "title": "Asset Operation Duration (p50 / p95 / p99)",
      "description": "Latency percentiles for asset CRUD operations. p50 is the median, p95 catches most slow queries, p99 reveals tail latency. High p99 on 'list' usually means large result sets or missing indexes. High p99 on 'get' may indicate cache misses hitting MongoDB.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, operation) (rate(assets_asset_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(assets_asset_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{operation}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(assets_asset_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{operation}}"
        }
      ]
    },
    {
      "title": "Asset List Results (p50 / p95 / p99)",
      "description": "Number of items returned per asset list query at various percentiles. Large result sets (p99 > 100) increase memory pressure and serialization time. Consider pagination limits if p99 is consistently high.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(assets_asset_list_results_count_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(assets_asset_list_results_count_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(assets_asset_list_results_count_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Asset Cache Hit/Miss",
      "description": "Asset cache lookups per second by result (hit, miss). High hit rate means assets are served from memory cache, reducing MongoDB load. A sudden drop in hit rate may indicate cache eviction pressure or a deployment restart.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
