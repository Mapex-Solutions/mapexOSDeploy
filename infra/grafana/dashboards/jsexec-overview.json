      "id": 100,
      "title": "Event Processing",
      "type": "row"
    },
    {
      "title": "Events Processed Rate",
      "description": "Rate of events processed per second, broken down by NATS consumer and status (success/error). This is the primary throughput indicator for the JS Executor. A drop in rate with rising consumer lag indicates the service cannot keep up with incoming events.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jsexec_events_processed_total[5m])",
          "legendFormat": "{{consumer}} / {{status}}"
        }
      ]
    },
    {
      "title": "Event Duration (p50 / p95 / p99)",
      "description": "End-to-end event processing latency percentiles by consumer. Includes NATS message handling, script lookup, V8 execution, and result publishing. p50 = typical latency, p95 = slow events, p99 = worst case. Compare with script duration to isolate whether overhead is in the framework or the script itself.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, consumer) (rate(jsexec_event_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{consumer}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, consumer) (rate(jsexec_event_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{consumer}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, consumer) (rate(jsexec_event_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{consumer}}"
        }
      ]
    },
    {
      "title": "Avg Payload Size",
      "description": "Average size of incoming event payloads. Large payloads increase serialization overhead and V8 memory pressure. If average size grows unexpectedly, investigate whether upstream datasources are sending bloated events.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10000
              },
              {
                "color": "red",
                "value": 50000
              }
            ]
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(jsexec_payload_size_bytes_sum[5m]) / rate(jsexec_payload_size_bytes_count[5m])",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "title": "Total Events Processed",
