      "id": 100,
      "title": "Webhook Auth",
      "type": "row"
    },
    {
      "title": "Total Auth Failures",
      "description": "Cumulative count of authentication failures since the last service restart, across all auth strategies (apikey, basic, bearer, none). A rising value indicates brute-force attempts, misconfigured datasources, or expired credentials.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(httpgw_event_auth_failures_total)",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "title": "Auth Attempts Rate",
      "description": "Webhook authentication attempts per second, broken down by auth strategy (apikey, basic, bearer, none) and result (success, failure). Shows the load on the authentication middleware and the distribution of auth methods used by datasources.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(httpgw_event_auth_total[5m])",
          "legendFormat": "{{auth_type}} / {{result}}"
        }
      ]
    },
    {
      "title": "Auth Latency (p50 / p95 / p99)",
      "description": "Webhook authentication validation latency per strategy. Measures time spent verifying API keys, basic credentials, or bearer tokens against MongoDB. High latency here adds directly to webhook response time. p99 spikes may indicate database connection issues.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 11,
        "y": 1
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(httpgw_event_auth_duration_seconds_bucket[5m]))",
          "legendFormat": "p50 {{auth_type}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(httpgw_event_auth_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{auth_type}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(httpgw_event_auth_duration_seconds_bucket[5m]))",
          "legendFormat": "p99 {{auth_type}}"
        }
      ]
    },
    {
      "title": "Auth Failures Rate",
      "description": "Authentication failures per second by auth strategy. Each failure triggers a security event published to NATS. Sustained failure rates indicate possible brute-force attacks, expired API keys, or misconfigured datasource credentials that need rotation.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 50
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(httpgw_event_auth_failures_total[5m])",
          "legendFormat": "{{auth_type}}"
        }
      ]
    },
    {
      "title": "Auth Gate Disabled (req/s)",
      "description": "Requests rejected with 403 because the resolved DataSource has Enabled=false. Runs BEFORE the auth strategy switch — disabled DataSources cannot reach apiKey/jwt/oauth2/ip_whitelist validation. Sustained non-zero rate indicates a client still hitting a DataSource that was disabled in the UI.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "id": 107,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(rate(httpgw_event_auth_failures_total{auth_type=\"disabled\"}[5m]))",
          "legendFormat": "disabled"
        }
      ]
    },
