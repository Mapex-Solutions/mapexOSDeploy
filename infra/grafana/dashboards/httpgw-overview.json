    {
      "title": "DS Cache Hit/Miss Rate",
      "description": "Datasource cache hit and miss rate per second. The tiered cache (in-memory + Redis) avoids MongoDB lookups on every webhook auth. A low hit ratio (<80%) means the cache is undersized or TTL is too short, causing unnecessary database load during event ingestion.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(httpgw_ds_cache_total[5m])",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "DS Cache Hit Ratio",
      "description": "Percentage of datasource cache lookups that resulted in a hit over the last 5 minutes. A healthy cache should maintain >90% hit ratio. Drops below 80% indicate cache churn, TTL expiration storms, or deployment-related cold starts.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 35
      },
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(httpgw_ds_cache_total{result=\"hit\"}[5m]) / (rate(httpgw_ds_cache_total{result=\"hit\"}[5m]) + rate(httpgw_ds_cache_total{result=\"miss\"}[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
