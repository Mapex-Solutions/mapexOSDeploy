        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(httpgw_event_processed_total[5m])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Events Published Rate",
      "description": "NATS publish attempts per second by subject (events.device, events.trigger) and result (success, error). Shows the fan-out pattern: each processed event is published to a NATS subject for downstream consumers (Router, Events service). Failures here mean messages are being dropped.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 11,
        "y": 10
      },
      "id": 7,
      "datasource": {
