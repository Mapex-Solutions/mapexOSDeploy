# =============================================================================
# MapexOS — Production Profile Template
# =============================================================================
#
# How to use:
#   1. cp envs/production.example.env envs/production.env
#   2. Fill EVERY value below (uncomment + replace).
#   3. Edit the canonical .env in the repo root:
#        ENV_PROFILE=production
#        GO_ENV=prod
#        NODE_ENV=prod
#        IMAGE_TAG=<the release tag you want to deploy, e.g. 1.0.0>
#   4. docker compose up -d
#
# The security guard in every Mapex service REFUSES to start when
# GO_ENV is not dev/development and any sensitive env var below is
# missing or still equals the leaked dev default. Forgetting an
# uncomment is a loud, fatal-at-boot error — not silent prod with dev
# secrets.
#
# Generators you can paste into a terminal:
#   AUTH_SECRET           openssl rand -hex 32        (256-bit hex)
#   INTERNAL_API_KEY      uuidgen | tr A-Z a-z
#   CREDENTIAL_MASTER_KEY openssl rand -hex 32        (256-bit hex, 64 chars)
#   NATS_PASSWORD         openssl rand -base64 24
#   CLICKHOUSE_PASSWORD   openssl rand -base64 24
#   MINIO_SECRET_KEY      openssl rand -base64 30
#
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
GO_ENV=prod
NODE_ENV=prod
LOG_LEVEL=info
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# MongoDB
# Point at your managed MongoDB cluster or self-hosted replica set.
# Example: mongodb://user:pass@host1:27017,host2:27017/?replicaSet=rs0
# -----------------------------------------------------------------------------
# MONGO_URI=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# NATS Core
# -----------------------------------------------------------------------------
# NATS_URL=
# NATS_USERNAME=
# NATS_PASSWORD=

# -----------------------------------------------------------------------------
# ClickHouse
# -----------------------------------------------------------------------------
# CLICKHOUSE_HOST=
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_DATABASE=
# CLICKHOUSE_USERNAME=
# CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# MinIO / S3
# -----------------------------------------------------------------------------
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_USE_SSL=true

# -----------------------------------------------------------------------------
# Auth (JWT)
# AUTH_SECRET must be ≥ 256 bits when AUTH_ALGORITHM=HS256.
# For RS256, leave AUTH_SECRET empty and set AUTH_JWKS_URL instead.
# -----------------------------------------------------------------------------
AUTH_STRATEGY=jwt
# AUTH_SECRET=
AUTH_ALGORITHM=HS256
AUTH_ROLES_SOURCE=token
AUTH_ROLES_PATH=roles
# AUTH_JWKS_URL=

# -----------------------------------------------------------------------------
# Internal API key (service-to-service auth — must be unique per deployment)
# -----------------------------------------------------------------------------
# INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# Credential vault — envelope encryption master key
# WARNING: rotating this value invalidates every secret encrypted under it.
# Pick once, store outside this file (Vault / KMS / sealed Secret), never
# commit. mapexVault and mongodb-init both read it.
# -----------------------------------------------------------------------------
# CREDENTIAL_MASTER_KEY=

