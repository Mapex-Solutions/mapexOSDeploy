# =============================================================================
# MapexOS — Local Profile
# =============================================================================
#
# Defaults for local evaluation. Loaded into every service container when
# ENV_PROFILE=local (the canonical .env default).
#
# Values here are PUBLIC by design — they exist so you can clone and boot
# without touching config. The security guard emits a visible
# [SECURITY WARNING] in the logs to remind you these are not production
# credentials. See envs/production.example.env to build a real prod
# profile.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
GO_ENV=dev
NODE_ENV=dev
LOG_LEVEL=info
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://mongodb:27017/?replicaSet=rs0

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# NATS Core
# -----------------------------------------------------------------------------
NATS_URL=nats://nats-core:4222
NATS_USERNAME=service
NATS_PASSWORD=service_secret

# -----------------------------------------------------------------------------
# ClickHouse
# CLICKHOUSE_DB / CLICKHOUSE_USER aliases exist because the upstream
# clickhouse-server image reads those names while the Go services read
# CLICKHOUSE_DATABASE / CLICKHOUSE_USERNAME. Both must match.
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=mapexos
CLICKHOUSE_DB=mapexos
CLICKHOUSE_USERNAME=mapexos_user
CLICKHOUSE_USER=mapexos_user
CLICKHOUSE_PASSWORD=mapexos_password

# -----------------------------------------------------------------------------
# Object store (S3 / MinIO) — generic contract, shared connection params.
# The per-service scoped credential (OBJECT_STORE_ACCESS_KEY/SECRET_KEY) is set
# in each service's own env file, pointing at its `svc-*` MinIO user.
# OBJECT_STORE_AUTH_IS_NEEDED=false switches to ambient IAM (no keys).
# Root credentials live ONLY in infra/minio/conf/minio.env (provisioning-only).
# -----------------------------------------------------------------------------
OBJECT_STORE_ENDPOINT=minio:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_USE_SSL=false
OBJECT_STORE_AUTH_IS_NEEDED=true

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
AUTH_STRATEGY=jwt
AUTH_SECRET=a-string-secret-at-least-256-bits-long
AUTH_ALGORITHM=HS256
AUTH_ROLES_SOURCE=token
AUTH_ROLES_PATH=roles

# -----------------------------------------------------------------------------
# Internal API key (service-to-service)
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=5230c2e2-e245-468d-89e8-94154cf520d0

# -----------------------------------------------------------------------------
# Credential vault — envelope encryption master key (mapexVault + mongodb-init)
# -----------------------------------------------------------------------------
CREDENTIAL_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

