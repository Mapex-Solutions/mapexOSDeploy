# =============================================================================
# MinIO Configuration
# =============================================================================
#
# Object Storage for:
#   - Templates (JS source + bytecode)
#   - Future: ClickHouse exports, backups, etc.
#
# Buckets:
#   - mapex-templates: Asset templates with JS scripts
#
# =============================================================================

# Root credentials (admin) — PROVISIONING ONLY.
# Used by minio-init to create buckets, per-service users and policies, and for
# console access. Services must NOT run under this account (see the per-service
# users below and INTERNALS minio-storage/context.md).
MINIO_ROOT_USER=mapex_admin
MINIO_ROOT_PASSWORD=mapex_admin_secret_change_me

# Console configuration
MINIO_BROWSER=on

# Region (optional, for S3 compatibility)
MINIO_REGION=us-east-1

# =============================================================================
# Per-service least-privilege users
# =============================================================================
# One user per service (1:1 with an AWS IAM user/role). minio-init creates each
# user and attaches a policy scoped to exactly the buckets/verbs it needs. Each
# service's env sets OBJECT_STORE_ACCESS_KEY/SECRET_KEY to its own pair below.
# CHANGE EVERY SECRET IN PRODUCTION (or use OBJECT_STORE_AUTH_IS_NEEDED=false and
# an instance/pod IAM role, in which case these keys are not used).
# Policy scope — see INTERNALS/documentation/architecture/minio-storage/context.md
#   svc-assets      RW: assets, templates, asset-auth, firmware
#   svc-jsexec      RO: assets, templates | RW: bytecode
#   svc-workflow    RW: workflows                    (Go workflow DAG engine)
#   svc-jsworkflow  Get+Put: workflows               (js-workflow-executor: reads scripts, writes bytecode)
#   svc-router      RO: assets, templates
#   svc-events      RO: templates
#   svc-broker      RO: asset-auth
#   svc-lns         RO: asset-auth
# =============================================================================
OBJECT_STORE_ASSETS_ACCESS_KEY=svc-assets
OBJECT_STORE_ASSETS_SECRET_KEY=svc-assets-secret-change-me
OBJECT_STORE_JSEXEC_ACCESS_KEY=svc-jsexec
OBJECT_STORE_JSEXEC_SECRET_KEY=svc-jsexec-secret-change-me
OBJECT_STORE_WORKFLOW_ACCESS_KEY=svc-workflow
OBJECT_STORE_WORKFLOW_SECRET_KEY=svc-workflow-secret-change-me
OBJECT_STORE_JSWORKFLOW_ACCESS_KEY=svc-jsworkflow
OBJECT_STORE_JSWORKFLOW_SECRET_KEY=svc-jsworkflow-secret-change-me
OBJECT_STORE_ROUTER_ACCESS_KEY=svc-router
OBJECT_STORE_ROUTER_SECRET_KEY=svc-router-secret-change-me
OBJECT_STORE_EVENTS_ACCESS_KEY=svc-events
OBJECT_STORE_EVENTS_SECRET_KEY=svc-events-secret-change-me
OBJECT_STORE_BROKER_ACCESS_KEY=svc-broker
OBJECT_STORE_BROKER_SECRET_KEY=svc-broker-secret-change-me
OBJECT_STORE_LNS_ACCESS_KEY=svc-lns
OBJECT_STORE_LNS_SECRET_KEY=svc-lns-secret-change-me
