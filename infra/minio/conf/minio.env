# =============================================================================
# MinIO Configuration
# =============================================================================
#
# Object Storage for:
#   - Templates (JS source + bytecode)
#   - Future: ClickHouse exports, backups, etc.
#
# Buckets:
#   - mapex-templates: Asset templates with JS scripts
#
# =============================================================================

# Root credentials (admin)
MINIO_ROOT_USER=mapex_admin
MINIO_ROOT_PASSWORD=mapex_admin_secret_change_me

# Console configuration
MINIO_BROWSER=on

# Region (optional, for S3 compatibility)
MINIO_REGION=us-east-1
