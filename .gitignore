# Internal
INTERNALS/

# Production secrets (template lives at infra/envs/production.example.env)
infra/envs/production.env

# Runtime data of infra services (minio, mongodb, clickhouse, nats, redis, mosquitto, prometheus, grafana, ...)
infra/*/data/**
!infra/*/data/**/.gitkeep

# Generated broker TLS material (created by the compose certs service on first boot)
infra/broker-certs/*
!infra/broker-certs/.gitkeep

# Local cert/data backups taken before container recreation
infra/_backups/

# Compiled seed-encryptor binary (built on demand by kek-bootstrap.sh)
infra/mongodb/init/seed-encryptor/seed-encryptor

# Node
node_modules/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

quickstart/device-mqtt/package-lock.json
