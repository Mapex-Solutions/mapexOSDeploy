# =============================================================================
# Router Service Environment Variables
# =============================================================================
SERVICE_NAME=router
HTTP_PORT=5003
MONGO_DATABASE=router
NATS_CLIENT_NAME=router-service
MAPEXOS_URL=http://mapex-iam:5000
ASSETS_URL=http://assets:5002

# -----------------------------------------------------------------------------
# Object store — scoped per-service credential (svc-router). Matches infra/minio/conf/minio.env.
# -----------------------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=svc-router
OBJECT_STORE_SECRET_KEY=svc-router-secret-change-me
