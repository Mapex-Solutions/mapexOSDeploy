# =============================================================================
# JS Workflow Executor Service Environment Variables
# =============================================================================
SERVICE_NAME=js-workflow-executor
HTTP_PORT=8001
NATS_CLIENT_NAME=js-workflow-executor-service
WORKFLOW_SERVICE_URL=http://workflow:5010
MINIO_WORKFLOWS_BUCKET=mapex-workflows
CPU_LIMIT=4

# -----------------------------------------------------------------------------
# Object store — scoped per-service credential (svc-jsworkflow). Matches infra/minio/conf/minio.env.
# -----------------------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=svc-jsworkflow
OBJECT_STORE_SECRET_KEY=svc-jsworkflow-secret-change-me
