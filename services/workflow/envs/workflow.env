# =============================================================================
# Workflow Service Environment Variables
# =============================================================================
SERVICE_NAME=workflow
HTTP_PORT=5007
MONGO_DATABASE=workflow
NATS_CLIENT_NAME=workflow-service
MAPEXOS_URL=http://mapex-iam:5000
VAULT_URL=http://mapexVault:5010

# -----------------------------------------------------------------------------
# Object store — scoped per-service credential (svc-workflow). Matches infra/minio/conf/minio.env.
# -----------------------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=svc-workflow
OBJECT_STORE_SECRET_KEY=svc-workflow-secret-change-me
