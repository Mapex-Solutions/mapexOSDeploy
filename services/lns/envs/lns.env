# =============================================================================
# LoRaWAN Network Server (LNS) Environment Variables
# =============================================================================
# Only service-specific overrides live here. Shared wiring (GO_ENV, NATS_URL +
# credentials, REDIS_HOST/PORT, OBJECT_STORE_* connection, INTERNAL_API_KEY) comes
# from ../infra/envs/local.env. Everything else falls back to the code defaults
# in the LNS DefaultConfiguration.
SERVICE_NAME=lorawan-lns
HTTP_PORT=5011

# Cold device/gateway config (TieredCache HTTP fallback) and the LoRaWAN
# device-keys KEK live behind the Assets MS and mapexVault.
ASSETS_URL=http://assets:5002
MAPEX_VAULT_URL=http://mapex-vault:5010

# L2 auth-cache bucket the Assets MS writes the projection to.
MINIO_ASSET_AUTH_BUCKET=mapex-asset-auth

# L1 cache directory (the container image prepares /var/cache/mapexos).
CACHE_L1_DIR=/var/cache/mapexos

# The Things Stack cluster key: HMAC for intra-process auth. Fixed so the
# foundation is in place for horizontal scaling (the open-source cluster
# auto-generates one per instance otherwise). Treat as a secret in production.
TTS_CLUSTER_KEY=ad6cf67c66536a8f9f64bad4171f97a50f977854683b4154a78988399092de2b

# -----------------------------------------------------------------------------
# Object store — scoped per-service credential (svc-lns). Matches infra/minio/conf/minio.env.
# -----------------------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=svc-lns
OBJECT_STORE_SECRET_KEY=svc-lns-secret-change-me
