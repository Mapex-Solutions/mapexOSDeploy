# =============================================================================
# Frontend (Web UI) — per-service environment overrides.
# =============================================================================
#
# The frontend bundle bakes a __PLACEHOLDER__ token in place of every
# backend URL at build time. When the container boots, the entrypoint
# reads each variable below and rewrites the matching placeholder in
# the served JS files. No image rebuild is needed to retarget a URL.
#
# Defaults assume the whole stack runs on the host that opens the
# browser (`localhost`). If services are spread across different hosts
# or VMs, override the matching lines below. Each URL is independent —
# you can point mapex-iam to a VM and assets to a Kubernetes service
# without touching the others.
#
# Examples:
#
#   # Whole stack on a VM at 192.168.15.6:
#   MAPEXOS_API_BASE_URL=http://192.168.15.6:5000
#   HTTP_GATEWAY_API_BASE_URL=http://192.168.15.6:5001
#   ...
#
#   # Split deployment:
#   MAPEXOS_API_BASE_URL=http://iam.mapex.local:5000
#   HTTP_GATEWAY_API_BASE_URL=http://gateway.mapex.local:5001
#   PLUGIN_CDN_BASE_URL=https://docs.mapexos.com/plugins
#
# =============================================================================

MAPEXOS_API_BASE_URL=http://localhost:5000
HTTP_GATEWAY_API_BASE_URL=http://localhost:5001
ASSETS_API_BASE_URL=http://localhost:5002
ROUTER_API_BASE_URL=http://localhost:5003
EVENTS_API_BASE_URL=http://localhost:5004
TRIGGERS_API_BASE_URL=http://localhost:5006
WORKFLOW_API_BASE_URL=http://localhost:5007
VAULT_API_BASE_URL=http://localhost:5010
JS_EXECUTOR_API_BASE_URL=http://localhost:8000
PLUGIN_CDN_BASE_URL=http://localhost:3099/plugins
