# =============================================================================
# Events Service Environment Variables
# =============================================================================
SERVICE_NAME=events
HTTP_PORT=5004
MONGO_DATABASE=events
NATS_CLIENT_NAME=events-service
MAPEXOS_URL=http://mapex-iam:5000
ASSETS_URL=http://assets:5002
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=mapexos

# -----------------------------------------------------------------------------
# Object store — scoped per-service credential (svc-events). Matches infra/minio/conf/minio.env.
# -----------------------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=svc-events
OBJECT_STORE_SECRET_KEY=svc-events-secret-change-me
