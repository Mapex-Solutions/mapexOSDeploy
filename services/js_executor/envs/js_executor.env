# =============================================================================
# JS Executor Service Environment Variables
# =============================================================================
SERVICE_NAME=js-executor
HTTP_PORT=8000
NATS_CLIENT_NAME=js-executor-service
ASSETS_SERVICE_URL=http://assets:5002
MINIO_ASSETS_BUCKET=mapex-assets
MINIO_TEMPLATES_BUCKET=mapex-templates
MINIO_BYTECODE_BUCKET=mapex-bytecode
CPU_LIMIT=4

# -----------------------------------------------------------------------------
# Object store — scoped per-service credential (svc-jsexec). Matches infra/minio/conf/minio.env.
# -----------------------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=svc-jsexec
OBJECT_STORE_SECRET_KEY=svc-jsexec-secret-change-me
