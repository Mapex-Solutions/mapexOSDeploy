# =============================================================================
# Assets Service Environment Variables
# =============================================================================
SERVICE_NAME=assets
HTTP_PORT=5002
MONGO_DATABASE=assets
NATS_CLIENT_NAME=assets-service
MINIO_TEMPLATES_BUCKET=mapex-templates
MINIO_MQTT_AUTH_BUCKET=mapex-mqtt-auth
MINIO_ASSET_AUTH_BUCKET=mapex-asset-auth
MAPEXOS_URL=http://mapex-iam:5000
ROUTER_SERVICE_URL=http://router:5003

## Health Monitor Configuration
HEALTH_MONITOR_SCAN_INTERVAL=600

# -----------------------------------------------------------------------------
# mapexVault internal URL
# Used by Assets MS mqttcerts/ OnMount to fetch the intermediate CA bundle.
# -----------------------------------------------------------------------------
MAPEX_VAULT_URL=http://mapex-vault:5010

