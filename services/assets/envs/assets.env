# =============================================================================
# Assets Service Environment Variables
# =============================================================================
SERVICE_NAME=assets
HTTP_PORT=5002
MONGO_DATABASE=assets
NATS_CLIENT_NAME=assets-service
MINIO_TEMPLATES_BUCKET=mapex-templates
MINIO_MQTT_AUTH_BUCKET=mapex-mqtt-auth
MINIO_ASSET_AUTH_BUCKET=mapex-asset-auth
MAPEXOS_URL=http://mapex-iam:5000
ROUTER_SERVICE_URL=http://router:5003

## Health Monitor Configuration
HEALTH_MONITOR_SCAN_INTERVAL=600

# -----------------------------------------------------------------------------
# mapexVault internal URL
# Used by Assets MS mqttcerts/ OnMount to fetch the intermediate CA bundle.
# -----------------------------------------------------------------------------
MAPEX_VAULT_URL=http://mapex-vault:5010

# -----------------------------------------------------------------------------
# OTA firmware store (S3-compatible; independent from the TieredCache MinIO).
#
# IMPORTANT: unlike the TieredCache MinIO (server-side only, reachable at the
# internal hostname `minio:9000`), this store MINTS PRESIGNED URLs the BROWSER
# uploads to and the DEVICE downloads from — so the endpoint MUST be reachable
# from those clients, NOT the Docker-internal hostname. Use the host-published
# address in dev (localhost:9000) or a public MinIO domain / real S3 in prod.
#
# The code default is localhost:9000 (browser-reachable in dev). Override to
# move firmware to real AWS S3 — no code change, other caches stay on MinIO:
#   FIRMWARE_STORE_ENDPOINT=s3.us-east-1.amazonaws.com
#   FIRMWARE_STORE_USE_SSL=true
#   FIRMWARE_STORE_REGION=us-east-1
#   FIRMWARE_STORE_ACCESS_KEY=<iam-access-key>
#   FIRMWARE_STORE_SECRET_KEY=<iam-secret-key>
#   FIRMWARE_STORE_BUCKET=mapex-firmware
# (The bucket needs a CORS policy allowing the app origin + the
#  x-amz-checksum-sha256 header for the browser direct upload.)
FIRMWARE_STORE_BUCKET=mapex-firmware


# -----------------------------------------------------------------------------
# Object store — scoped per-service credential (svc-assets). Matches infra/minio/conf/minio.env.
# -----------------------------------------------------------------------------
OBJECT_STORE_ACCESS_KEY=svc-assets
OBJECT_STORE_SECRET_KEY=svc-assets-secret-change-me
